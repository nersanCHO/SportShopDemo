<!DOCTYPE html>
<html lang="bg">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SportShop</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="ss-page-shell">
    <header>
        <nav class="navbar navbar-expand-lg ss-navbar">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Products" asp-action="Index">
                    <span class="ss-brand-badge">
                        <i class="bi bi-lightning-charge-fill"></i>
                    </span>
                    <span class="fw-semibold">SportShop</span>
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Products" asp-action="Index">
                                <i class="bi bi-grid me-1"></i>Продукти
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Cart" asp-action="Index">
                                <i class="bi bi-bag me-1"></i>Количка
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Favorites" asp-action="Index">
                                <i class="bi bi-heart me-1"></i>Любими
                            </a>
                        </li>
                    </ul>

                    <div class="d-flex align-items-center gap-2">
                        @await Html.PartialAsync("_LoginPartial")

                        @if (User?.IsInRole("Admin") == true || User?.IsInRole("Administrator") == true || User?.IsInRole("admin") == true)
                        {
                            <div class="nav-item">
                                <a class="btn btn-sm btn-outline-light" asp-area="" asp-controller="AdminProducts" asp-action="Index">Админ</a>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main class="container py-4 ss-main-content">
        @RenderBody()
    </main>

    <footer class="border-top py-3 ss-footer">
        <div class="container d-flex flex-wrap gap-2 justify-content-between align-items-center text-muted small">
            <div>SportShop - Онлайн магазин за спортни стоки</div>
            <div class="d-flex gap-3">
                <span class="d-inline-flex align-items-center gap-2"><i class="bi bi-truck"></i> Бърза доставка</span>
                <span class="d-inline-flex align-items-center gap-2"><i class="bi bi-shield-check"></i> Сигурно плащане</span>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>