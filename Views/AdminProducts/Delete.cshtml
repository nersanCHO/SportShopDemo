@model SportShop.Models.Product
@{
    ViewData["Title"] = "Изтриване";
}

<h1 class="mb-3">Изтриване</h1>

<div class="alert alert-warning">
    Сигурен ли си, че искаш да изтриеш <strong>@Model.Name</strong>?
</div>

<div class="card card-body">
    <div class="d-flex align-items-center gap-3">
        <img src="@Model.ImagePath" alt="" style="width:120px; height:120px; object-fit:cover;" class="rounded" />
        <div>
            <div class="fw-semibold">@Model.Name</div>
            <div class="text-muted">@Model.Sport · @Model.SubCategory · @Model.Gender</div>
            <div class="fw-bold mt-1">@Model.Price.ToString("0.00") €</div>
        </div>
    </div>

    <div class="d-flex gap-2 mt-3">
        <a class="btn btn-outline-secondary" asp-action="Index">Отказ</a>
        <form asp-action="Delete" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Id" />
            <button class="btn btn-danger" type="submit">Изтрий</button>
        </form>
    </div>
</div>
