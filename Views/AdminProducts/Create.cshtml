@model SportShop.Models.Product
@using SportShop.Models
@{
    ViewData["Title"] = "Нов продукт";

    // Preset mapping of sports -> subcategories (edit as needed)
    var sportMap = new Dictionary<string, string[]>
    {
        ["Running"] = new[] { "Shoes", "Apparel", "Accessories" },
        ["Football"] = new[] { "Cleats", "Shin Guards", "Balls", "Apparel" },
        ["Fitness"] = new[] { "Equipment", "Apparel", "Supplements" },
        ["Tennis"] = new[] { "Rackets", "Balls", "Shoes", "Apparel" },
        ["Cycling"] = new[] { "Bikes", "Helmets", "Apparel", "Accessories" }
    };

    var sportMapJson = System.Text.Json.JsonSerializer.Serialize(sportMap);
}

<h1 class="mb-3">Нов продукт</h1>

<form asp-action="Create" method="post" enctype="multipart/form-data" class="card card-body">
    @Html.AntiForgeryToken()
    <div class="row g-3">
        <div class="col-md-6">
            <label class="form-label">Име</label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="col-md-3">
            <label class="form-label">Спорт</label>
            <select asp-for="Sport" id="SportSelect" class="form-select">
                <option value="">Избери спорт...</option>
                @foreach (var s in sportMap.Keys)
                {
                    <option value="@s" selected="@(Model.Sport == s ? "selected" : null)">@s</option>
                }
            </select>
            <span asp-validation-for="Sport" class="text-danger"></span>
        </div>

        <div class="col-md-3">
            <label class="form-label">Подкатегория</label>
            <select asp-for="SubCategory" id="SubCategorySelect" class="form-select">
                <option value="">Избери подкатегория...</option>
                @* JS will populate options on load; this keeps markup for model binding/validation *@
            </select>
            <span asp-validation-for="SubCategory" class="text-danger"></span>
        </div>

        <div class="col-md-3">
            <label class="form-label">Цена (лв.)</label>
            <input asp-for="Price" class="form-control" />
            <span asp-validation-for="Price" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label class="form-label">Мъже/Жени</label>
            <select asp-for="Gender" class="form-select" asp-items="Html.GetEnumSelectList<GenderTarget>()"></select>
        </div>

        <div class="col-md-6">
            <label class="form-label">Основна снимка (заглавна)</label>
            <input type="file" name="titleImage" class="form-control" accept="image/*" />
            <div class="form-text">Качи основната (заглавна) снимка, която ще се показва като thumb и първа в карусела.</div>
        </div>

        <div class="col-md-6">
            <label class="form-label">Допълнителни снимки (може повече от една)</label>
            <input type="file" name="images" class="form-control" accept="image/*" multiple />
            <div class="form-text">Качи допълнителни снимки. Ако не качиш основна снимка, първата от тези ще бъде зададена като заглавна.</div>
        </div>

        <div class="col-12">
            <label class="form-label">Описание</label>
            <textarea asp-for="Description" class="form-control" rows="4"></textarea>
        </div>
    </div>

    <div class="d-flex gap-2 mt-3">
        <a class="btn btn-outline-secondary" asp-action="Index">Назад</a>
        <button class="btn btn-primary" type="submit">Запази</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        // mapping injected from server
        const mapping = @Html.Raw(sportMapJson);

        const sportSelect = document.getElementById('SportSelect');
        const subSelect = document.getElementById('SubCategorySelect');

        function populateSubcategories(selectedSport, selectedSub) {
            // clear existing options
            subSelect.innerHTML = '';
            const placeholder = document.createElement('option');
            placeholder.value = '';
            placeholder.textContent = 'Избери подкатегория...';
            subSelect.appendChild(placeholder);

            if (!selectedSport || !mapping[selectedSport]) return;

            mapping[selectedSport].forEach(sub => {
                const opt = document.createElement('option');
                opt.value = sub;
                opt.textContent = sub;
                if (sub === selectedSub) opt.selected = true;
                subSelect.appendChild(opt);
            });
        }

        document.addEventListener('DOMContentLoaded', function () {
            // populate using the current model values (if any)
            populateSubcategories(sportSelect.value, '@(Model.SubCategory ?? "")');

            // when sport changes, update subcategories and clear previous selection
            sportSelect.addEventListener('change', function () {
                populateSubcategories(this.value, '');
            });
        });
    </script>
}
