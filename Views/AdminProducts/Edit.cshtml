@model SportShop.Models.Product
@using SportShop.Models
@{
    ViewData["Title"] = "Редакция";
}

<h1 class="mb-3">Редакция</h1>

<form asp-action="Edit" method="post" enctype="multipart/form-data" class="card card-body">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />

    <div class="row g-3">
        <div class="col-md-6">
            <label class="form-label">Име</label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label class="form-label">Спорт</label>
            <input asp-for="Sport" class="form-control" />
            <span asp-validation-for="Sport" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label class="form-label">Подкатегория</label>
            <input asp-for="SubCategory" class="form-control" />
            <span asp-validation-for="SubCategory" class="text-danger"></span>
        </div>

        <div class="col-md-3">
            <label class="form-label">Цена (лв.)</label>
            <input asp-for="Price" class="form-control" />
            <span asp-validation-for="Price" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label class="form-label">Мъже/Жени</label>
            <select asp-for="Gender" class="form-select" asp-items="Html.GetEnumSelectList<GenderTarget>()"></select>
        </div>
        <div class="col-md-6">
            <label class="form-label">Снимка (нова)</label>
            <input type="file" name="image" class="form-control" accept="image/*" />
            <div class="form-text">Текуща:</div>
            <img src="@Model.ImagePath" alt="" style="width:160px; height:160px; object-fit:cover;" class="rounded border" />
        </div>

        <div class="col-12">
            <label class="form-label">Описание</label>
            <textarea asp-for="Description" class="form-control" rows="4"></textarea>
        </div>
    </div>

    <div class="d-flex gap-2 mt-3">
        <a class="btn btn-outline-secondary" asp-action="Index">Назад</a>
        <button class="btn btn-primary" type="submit">Запази</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
