@model List<SportShop.Models.CartItem>
@{
    ViewData["Title"] = "Количка";
    decimal total = ViewBag.Total ?? 0m;
}

<h1 class="mb-3">Количка</h1>

@if (!Model.Any())
{
    <div class="alert alert-info">Количката е празна.</div>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
            <tr>
                <th>Продукт</th>
                <th class="text-end">Цена</th>
                <th class="text-center">Количество</th>
                <th class="text-end">Сума</th>
                <th></th>
            </tr>
            </thead>
            <tbody>
            @foreach (var i in Model)
            {
                <tr>
                    <td>
                        <div class="d-flex align-items-center gap-2">
                            <img src="@(i.Product?.ImagePath)" alt="" style="width:56px; height:56px; object-fit:cover;" class="rounded" />
                            <div>
                                <div class="fw-semibold">@(i.Product?.Name)</div>
                                <div class="text-muted small">@(i.Product?.Sport) · @(i.Product?.SubCategory)</div>
                            </div>
                        </div>
                    </td>
                    <td class="text-end">@((i.Product?.Price ?? 0m).ToString("0.00")) лв.</td>
                    <td class="text-center">
                        <div class="d-inline-flex align-items-center gap-2">
                            <form asp-action="Decrease" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="cartItemId" value="@i.Id" />
                                <button class="btn btn-sm btn-outline-secondary" type="submit">-</button>
                            </form>
                            <span class="fw-semibold">@i.Quantity</span>
                            <form asp-action="Add" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="productId" value="@i.ProductId" />
                                <button class="btn btn-sm btn-outline-secondary" type="submit">+</button>
                            </form>
                        </div>
                    </td>
                    <td class="text-end">@(((i.Product?.Price ?? 0m) * i.Quantity).ToString("0.00")) лв.</td>
                    <td class="text-end">
                        <form asp-action="Remove" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="cartItemId" value="@i.Id" />
                            <button class="btn btn-sm btn-outline-danger" type="submit">Премахни</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>

    <div class="d-flex justify-content-end">
        <div class="card card-body" style="max-width: 360px;">
            <div class="d-flex justify-content-between">
                <span class="fw-semibold">Обща сума:</span>
                <span class="fw-bold">@total.ToString("0.00") лв.</span>
            </div>
            <div class="text-muted small mt-2">(Демо) Тук може да добавиш checkout/поръчка, ако ти трябва за документацията.</div>
        </div>
    </div>
}
