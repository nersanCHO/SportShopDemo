@model List<SportShop.Models.CartItem>

@{
    ViewData["Title"] = "Количка";

    decimal total = ViewBag.Total ?? 0m;
    var favIds = ViewBag.FavoriteIds as List<int> ?? new List<int>();
    var cartIndexUrl = Url.Action("Index", "Cart");
}

<h1>Количка</h1>

<p>Провери количествата и финализирай поръчката.</p>

<div class="d-flex gap-2 mb-4">
    <a asp-controller="Products" asp-action="Index" class="btn btn-outline-secondary">Продукти</a>
    <a asp-controller="Favorites" asp-action="Index" class="btn btn-outline-secondary">Любими</a>
</div>

@if (TempData["CartMessage"] != null)
{
    <div class="alert alert-warning">@TempData["CartMessage"]</div>
}

@if (TempData["OrderMessage"] != null)
{
    <div class="alert alert-info">@TempData["OrderMessage"]</div>
}

@if (!Model.Any())
{
    <div class="alert alert-info">
        Количката е празна. Добави продукти.
    </div>
}
else
{
    <div class="row g-4">
        <div class="col-lg-8">
            <h3>Твоите артикули</h3>
            <p class="text-muted">@Model.Count бр.</p>

            @foreach (var i in Model)
            {
                var isFav = favIds.Contains(i.ProductId);
                var p = i.Product;
                var thumb = p?.ImagePath ?? p?.Photos?.FirstOrDefault()?.ImagePath ?? "/images/products/default.png";
                var price = p?.Price ?? 0m;
                var lineTotal = price * i.Quantity;

                <div class="card mb-3">
                    <div class="card-body">
                        <div class="row g-3 align-items-center">
                            <div class="col-md-3">
                                @if (p != null)
                                {
                                    <a asp-controller="Products" asp-action="Details" asp-route-id="@p.Id" class="d-block">
                                        <img src="@thumb" alt="@(p?.Name)" class="img-fluid rounded" />
                                    </a>
                                }
                                else
                                {
                                    <img src="@thumb" alt="@(p?.Name)" class="img-fluid rounded" />
                                }
                            </div>

                            <div class="col-md-5">
                                @if (p != null)
                                {
                                    <h5 class="mb-1">
                                        <a asp-controller="Products" asp-action="Details" asp-route-id="@p.Id" class="text-decoration-none text-dark">
                                            @p.Name
                                        </a>
                                    </h5>
                                }
                                else
                                {
                                    <h5 class="mb-1">@(p?.Name)</h5>
                                }

                                <div class="text-muted small">
                                    @(p?.Sport) · @(p?.SubCategory) · @(p?.Gender) · Размер: @i.SelectedSize
                                </div>
                                <div class="mt-2 fw-bold">@price.ToString("0.00") €</div>
                                <div class="text-muted">Сума: @lineTotal.ToString("0.00") €</div>
                            </div>

                            <div class="col-md-4">
                                <div class="d-flex align-items-center gap-2 mb-3">
                                    <form asp-action="Decrease" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="cartItemId" value="@i.Id" />
                                        <button type="submit" class="btn btn-outline-secondary">-</button>
                                    </form>

                                    <span class="fw-bold">@i.Quantity</span>

                                    <form asp-action="Add" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="productId" value="@i.ProductId" />
                                        <input type="hidden" name="selectedSize" value="@i.SelectedSize" />
                                        <button type="submit" class="btn btn-outline-secondary">+</button>
                                    </form>
                                </div>

                                <div class="d-flex gap-2 flex-wrap">
                                    <form asp-controller="Favorites" asp-action="Toggle" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="productId" value="@i.ProductId" />
                                        <input type="hidden" name="returnUrl" value="@cartIndexUrl" />
                                        <button type="submit" class="btn btn-outline-dark">
                                            @(isFav ? "В любими" : "Любими")
                                        </button>
                                    </form>

                                    <form asp-action="Remove" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="cartItemId" value="@i.Id" />
                                        <button type="submit" class="btn btn-outline-danger">Премахни</button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="col-lg-4">
            <div class="card mb-4">
                <div class="card-body">
                    <h4>Обобщение</h4>

                    <div class="d-flex justify-content-between">
                        <span>Междинна сума</span>
                        <strong>@total.ToString("0.00") €</strong>
                    </div>

                    <div class="d-flex justify-content-between">
                        <span>Доставка</span>
                        <strong>0.00 € (демо)</strong>
                    </div>

                    <hr />

                    <div class="d-flex justify-content-between fs-5">
                        <span>Общо</span>
                        <strong>@total.ToString("0.00") €</strong>
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-body">
                    <h4>Финализирай поръчката</h4>
                    <p class="text-muted">
                        Това е демонстрация. След потвърждение поръчката ще бъде записана като .txt файл в папката
                        <code>wwwroot/orders</code>.
                    </p>

                    <form asp-action="Checkout" method="post">
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label class="form-label" for="FullName">Име и фамилия</label>
                            <input class="form-control" id="FullName" name="FullName" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label" for="Address">Адрес</label>
                            <input class="form-control" id="Address" name="Address" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label" for="Phone">Телефон</label>
                            <input class="form-control" id="Phone" name="Phone" required />
                        </div>

                        <div class="d-flex gap-2">
                            <a asp-controller="Products" asp-action="Index" class="btn btn-outline-secondary">Отказ</a>
                            <button type="submit" class="btn btn-success">Изпрати поръчката</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
}