@model List<SportShop.Models.Product>

@{
    ViewData["Title"] = "Любими";
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
}

<h1>Любими</h1>

<p>Запази това, което ти харесва – после го отвори и избери размер.</p>

<div class="d-flex gap-2 mb-4">
    <a asp-controller="Products" asp-action="Index" class="btn btn-outline-secondary">Продукти</a>
    <a asp-controller="Cart" asp-action="Index" class="btn btn-outline-secondary">Количка</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        Нямаш добавени любими продукти. Разгледай продуктите.
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var p in Model)
        {
            var thumb = !string.IsNullOrWhiteSpace(p.ImagePath)
            ? p.ImagePath
            : p.Photos?.FirstOrDefault()?.ImagePath ?? "/images/products/default.png";

            <div class="col-md-6 col-lg-4">
                <div class="card h-100">
                    <a asp-controller="Products" asp-action="Details" asp-route-id="@p.Id" class="d-block">
                        <img src="@thumb" class="card-img-top" alt="@p.Name" style="height: 260px; object-fit: cover;" />
                    </a>

                    <div class="card-body d-flex flex-column">
                        <div class="text-muted small">@p.Sport · @p.SubCategory</div>
                        <h5 class="card-title mt-1">
                            <a asp-controller="Products" asp-action="Details" asp-route-id="@p.Id" class="text-decoration-none text-dark">@p.Name</a>
                        </h5>
                        <div class="mb-2 fw-bold">@p.Price.ToString("0.00") лв.</div>
                        <div class="mb-3 text-muted">@p.Gender · Размери: @p.DisplaySizes</div>

                        <div class="mt-auto d-flex gap-2 flex-wrap">
                            <a asp-controller="Products" asp-action="Details" asp-route-id="@p.Id" class="btn btn-primary">
                                Детайли / Избери размер
                            </a>

                            <form asp-controller="Favorites" asp-action="Toggle" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="productId" value="@p.Id" />
                                <input type="hidden" name="returnUrl" value="@returnUrl" />
                                <button type="submit" class="btn btn-outline-danger">Премахни</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}