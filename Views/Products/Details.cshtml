@model SportShop.Models.Product
@{
    ViewData["Title"] = "Детайли";
}

<div class="row g-4">
    <div class="col-md-5">
        <img src="@Model.ImagePath" alt="@Model.Name" class="img-fluid rounded" style="width:100%; object-fit:cover;" />
    </div>
    <div class="col-md-7">
        <h1>@Model.Name</h1>
        <div class="text-muted">@Model.Sport · @Model.SubCategory · @Model.Gender</div>
        <div class="fs-3 fw-semibold mt-2">@Model.Price.ToString("0.00") лв.</div>
        @if (!string.IsNullOrWhiteSpace(Model.Description))
        {
            <p class="mt-3">@Model.Description</p>
        }

        <div class="d-flex gap-2 mt-4 flex-wrap">
            <a class="btn btn-outline-secondary" asp-action="Index">Назад</a>

            @if (User.Identity?.IsAuthenticated == true)
            {
                <form asp-controller="Cart" asp-action="Add" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="productId" value="@Model.Id" />
                    <button class="btn btn-primary" type="submit">Добави в количка</button>
                </form>

                <form asp-controller="Favorites" asp-action="Toggle" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="productId" value="@Model.Id" />
                    <button class="btn btn-outline-danger" type="submit">Добави/Премахни от Любими</button>
                </form>
            }
            else
            {
                <div class="alert alert-warning mb-0">За да добавяш в количка/любими, влез в профила си.</div>
            }
        </div>
    </div>
</div>
