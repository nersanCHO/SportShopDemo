@model List<SportShop.Models.Product>
@using SportShop.Models

@{
    ViewData["Title"] = "Продукти";

    var sports = ViewBag.Sports as List<string> ?? new();
    var subs = ViewBag.SubCategories as List<string> ?? new();
    var favIds = ViewBag.FavoriteIds as List<int> ?? new();

    string? selectedSport = Context.Request.Query["sport"].FirstOrDefault();
    string? selectedSub = Context.Request.Query["subCategory"].FirstOrDefault();
    string? selectedGender = Context.Request.Query["gender"].FirstOrDefault();
    string? q = Context.Request.Query["q"].FirstOrDefault();
    string? minPrice = Context.Request.Query["minPrice"].FirstOrDefault();
    string? maxPrice = Context.Request.Query["maxPrice"].FirstOrDefault();

    var currentUrl = Context.Request.Path + Context.Request.QueryString;
}

<h1>Продукти</h1>

<p>Екипировка и обувки за всеки спорт – бързо, лесно, удобно.</p>

<div class="d-flex gap-2 mb-4">
    <a asp-controller="Cart" asp-action="Index" class="btn btn-outline-secondary">Количка</a>
    <a asp-controller="Favorites" asp-action="Index" class="btn btn-outline-secondary">Любими</a>
</div>

<form method="get" class="row g-3 mb-4">
    <div class="col-md-4">
        <label class="form-label">Търсене</label>
        <input type="text" name="q" value="@q" class="form-control" />
    </div>

    <div class="col-md-2">
        <label class="form-label">Мъже/Жени</label>
        <select name="gender" class="form-select">
            <option value="">(всички)</option>
            <option value="Men" selected="@(selectedGender == "Men")">Мъже</option>
            <option value="Women" selected="@(selectedGender == "Women")">Жени</option>
            <option value="Unisex" selected="@(selectedGender == "Unisex")">Унисекс</option>
        </select>
    </div>

    <div class="col-md-2">
        <label class="form-label">Спорт</label>
        <select name="sport" class="form-select">
            <option value="">(всички)</option>
            @foreach (var s in sports)
            {
                <option value="@s" selected="@(selectedSport == s)">@s</option>
            }
        </select>
    </div>

    <div class="col-md-2">
        <label class="form-label">Подкатегория</label>
        <select name="subCategory" class="form-select">
            <option value="">(всички)</option>
            @foreach (var sc in subs)
            {
                <option value="@sc" selected="@(selectedSub == sc)">@sc</option>
            }
        </select>
    </div>

    <div class="col-md-1">
        <label class="form-label">Мин</label>
        <input type="number" step="0.01" name="minPrice" value="@minPrice" class="form-control" />
    </div>

    <div class="col-md-1">
        <label class="form-label">Макс</label>
        <input type="number" step="0.01" name="maxPrice" value="@maxPrice" class="form-control" />
    </div>

    <div class="col-12">
        <button type="submit" class="btn btn-primary">Филтър</button>
    </div>
</form>

@if (!Model.Any())
{
    <div class="alert alert-info">Няма намерени продукти.</div>
}
else
{
    <div class="row g-4">
        @foreach (var p in Model)
        {
            var isFav = favIds.Contains(p.Id);
            var favoriteLabel = isFav ? "Премахни от любими" : "Добави в любими";
            var thumb = !string.IsNullOrWhiteSpace(p.ImagePath)
            ? p.ImagePath
            : p.Photos?.FirstOrDefault()?.ImagePath ?? "/images/products/default.png";

            <div class="col-md-6 col-lg-4">
                <div class="card h-100 ss-card">
                    <a asp-action="Details" asp-route-id="@p.Id" class="d-block">
                        <img src="@thumb" class="card-img-top ss-card-img" alt="@p.Name" />
                    </a>

                    <div class="card-body d-flex flex-column">
                        <div class="text-muted small">@p.Sport · @p.SubCategory</div>

                        <h5 class="card-title mt-1">
                            <a asp-action="Details" asp-route-id="@p.Id" class="text-decoration-none text-dark">
                                @p.Name
                            </a>
                        </h5>

                        <div class="mb-2 fw-bold">@p.Price.ToString("0.00") €</div>
                        <div class="mb-3 text-muted">@p.Gender · Размери: @p.DisplaySizes</div>

                        <div class="mt-auto d-flex gap-2 align-items-center ss-product-card-actions">
                            <a asp-action="Details"
                               asp-route-id="@p.Id"
                               class="btn btn-primary flex-grow-1">
                                Детайли / Избери размер
                            </a>

                            @if (User.Identity?.IsAuthenticated == true)
                            {
                                <form asp-controller="Favorites" asp-action="Toggle" method="post" class="d-inline-flex">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="productId" value="@p.Id" />
                                    <input type="hidden" name="returnUrl" value="@currentUrl" />

                                    <button type="submit"
                                            class="btn ss-favorite-btn @(isFav ? "active" : "")"
                                            title="@favoriteLabel"
                                            aria-label="@favoriteLabel"
                                            aria-pressed="@(isFav.ToString().ToLowerInvariant())">
                                        <i class="bi @(isFav ? "bi-heart-fill" : "bi-heart")"></i>
                                        <span class="visually-hidden">@favoriteLabel</span>
                                    </button>
                                </form>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}