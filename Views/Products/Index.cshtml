@model List<SportShop.Models.Product>
@using SportShop.Models

@{
    ViewData["Title"] = "Продукти";
    var sports = ViewBag.Sports as List<string> ?? new();
    var subs = ViewBag.SubCategories as List<string> ?? new();
    string? selectedSport = Context.Request.Query["sport"].FirstOrDefault();
    string? selectedSub = Context.Request.Query["subCategory"].FirstOrDefault();
    string? selectedGender = Context.Request.Query["gender"].FirstOrDefault();
    string? q = Context.Request.Query["q"].FirstOrDefault();
    string? minPrice = Context.Request.Query["minPrice"].FirstOrDefault();
    string? maxPrice = Context.Request.Query["maxPrice"].FirstOrDefault();

    var favIds = ViewBag.FavoriteIds as List<int> ?? new List<int>();
    var currentUrl = Context.Request.Path + Context.Request.QueryString;
}

<div class="ss-hero mb-4">
    <div class="ss-hero-inner">
        <div class="d-flex flex-wrap gap-3 align-items-end justify-content-between">
            <div>
                <h1 class="mb-1">Продукти</h1>
                <div class="opacity-75">Екипировка и обувки за всеки спорт – бързо, лесно, удобно.</div>
            </div>
            <div class="d-flex gap-2">
                <a class="btn btn-light btn-sm" asp-controller="Cart" asp-action="Index"><i class="bi bi-bag"></i> Количка</a>
                <a class="btn btn-outline-light btn-sm" asp-controller="Favorites" asp-action="Index"><i class="bi bi-heart"></i> Любими</a>
            </div>
        </div>
    </div>
</div>

<form method="get" class="card card-body mb-4 ss-card">
    <div class="row g-3 align-items-end">
        <div class="col-md-3">
            <label class="form-label">Търсене</label>
            <input class="form-control" name="q" value="@q" placeholder="име/описание" />
        </div>

        <div class="col-md-2">
            <label class="form-label">Мъже/Жени</label>
            <select class="form-select" name="gender">
                <option value="">(всички)</option>
                <option value="@( (int)GenderTarget.Men )" selected="@(selectedGender == ((int)GenderTarget.Men).ToString())">Мъже</option>
                <option value="@( (int)GenderTarget.Women )" selected="@(selectedGender == ((int)GenderTarget.Women).ToString())">Жени</option>
                <option value="@( (int)GenderTarget.Unisex )" selected="@(selectedGender == ((int)GenderTarget.Unisex).ToString())">Унисекс</option>
            </select>
        </div>

        <div class="col-md-2">
            <label class="form-label">Спорт</label>
            <select class="form-select" name="sport">
                <option value="">(всички)</option>
                @foreach (var s in sports)
                {
                    <option value="@s" selected="@(selectedSport == s)">@s</option>
                }
            </select>
        </div>

        <div class="col-md-2">
            <label class="form-label">Подкатегория</label>
            <select class="form-select" name="subCategory">
                <option value="">(всички)</option>
                @foreach (var sc in subs)
                {
                    <option value="@sc" selected="@(selectedSub == sc)">@sc</option>
                }
            </select>
        </div>

        <div class="col-md-1">
            <label class="form-label">Мин</label>
            <input class="form-control" name="minPrice" value="@minPrice" inputmode="decimal" />
        </div>
        <div class="col-md-1">
            <label class="form-label">Макс</label>
            <input class="form-control" name="maxPrice" value="@maxPrice" inputmode="decimal" />
        </div>

        <div class="col-md-2 d-grid">
            <button class="btn btn-primary" type="submit"><i class="bi bi-funnel"></i> Филтър</button>
        </div>
        <div class="col-md-1 d-grid">
            <a class="btn ss-btn-soft" href="@Context.Request.Path" title="Изчисти филтрите"><i class="bi bi-arrow-counterclockwise"></i></a>
        </div>
    </div>
</form>

@if (!Model.Any())
{
    <div class="alert alert-info">Няма намерени продукти.</div>
}
else
{
    <div class="row row-cols-1 row-cols-md-3 g-3">
        @foreach (var p in Model)
        {
            var isFav = favIds.Contains(p.Id);
            var thumb = p.Photos?.FirstOrDefault()?.ImagePath ?? p.ImagePath;

            <div class="col">
                <div class="card h-100 ss-card">
                    <div class="position-relative">
                        <a asp-action="Details" asp-route-id="@p.Id" aria-label="Виж детайли за @p.Name">
                            <img class="card-img-top ss-card-img" src="@thumb" alt="@p.Name" />
                        </a>

                        <div class="position-absolute top-0 start-0 p-2 d-flex gap-2 flex-wrap">
                            <span class="badge rounded-pill ss-badge"><i class="bi bi-activity"></i> @p.Sport</span>
                            <span class="badge rounded-pill ss-badge">@p.SubCategory</span>
                        </div>
                    </div>

                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start gap-2">
                            <h5 class="card-title mb-1">
                                <a asp-action="Details" asp-route-id="@p.Id" class="text-decoration-none text-dark">@p.Name</a>
                            </h5>
                            <span class="ss-price fw-semibold" title="Цена">
                                <i class="bi bi-cash-coin"></i>
                                @p.Price.ToString("0.00") лв.
                            </span>
                        </div>
                        <div class="ss-muted small">@p.Gender · Размер: @p.Size</div>
                    </div>

                    <div class="card-footer bg-white d-flex align-items-center gap-2">
                        <a class="btn btn-outline-primary" asp-action="Details" asp-route-id="@p.Id">
                            <i class="bi bi-eye"></i> Детайли
                        </a>

                        <form asp-controller="Favorites" asp-action="Toggle" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="productId" value="@p.Id" />
                            <input type="hidden" name="returnUrl" value="@currentUrl" />
                            <button class="btn btn-outline-danger" type="submit" title="Любими">
                                <i class="bi @(isFav ? "bi-heart-fill" : "bi-heart")"></i>
                            </button>
                        </form>

                        <form asp-controller="Cart" asp-action="Add" method="post" class="ms-auto">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="productId" value="@p.Id" />
                            <button class="btn btn-primary" type="submit"><i class="bi bi-bag-plus"></i> В количка</button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
}