@page
@model SportShop.Areas.Identity.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Вход";
    var returnUrl = Model.ReturnUrl ?? Url.Content("~/");
}

<div class="ss-hero-mini mb-4">
    <div class="ss-hero-inner d-flex flex-wrap gap-3 align-items-end justify-content-between">
        <div>
            <h1 class="mb-1"><i class="bi bi-box-arrow-in-right"></i> Вход</h1>
            <div class="opacity-75">Влез с твоя акаунт, за да продължиш.</div>
        </div>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-md-7 col-lg-5">
        <div class="card ss-card">
            <div class="card-body">
                <form method="post" asp-route-returnUrl="@returnUrl" class="needs-validation" novalidate>
                    <h5 class="mb-3 fw-semibold">Влез в акаунта си</h5>

                    <div class="mb-3">
                        <label asp-for="Input.Email" class="form-label"></label>
                        <input asp-for="Input.Email" class="form-control" />
                        <span asp-validation-for="Input.Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.Password" class="form-label"></label>
                        <input asp-for="Input.Password" class="form-control" />
                        <span asp-validation-for="Input.Password" class="text-danger small"></span>
                    </div>

                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <div class="form-check">
                            <input asp-for="Input.RememberMe" class="form-check-input" />
                            <label asp-for="Input.RememberMe" class="form-check-label"></label>
                        </div>
                        <a asp-page="/Account/ForgotPassword" class="small">Забравена парола?</a>
                    </div>

                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-box-arrow-in-right me-1"></i> Вход
                    </button>

                    <div class="text-center mt-3 small text-muted">
                        Нямаш акаунт? <a asp-page="/Account/Register" class="text-decoration-none">Регистрирай се</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}