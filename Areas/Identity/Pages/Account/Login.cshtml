@page
@model SportShop.Areas.Identity.Pages.Account.LoginModel
@inject Microsoft.AspNetCore.Identity.UserManager<SportShop.Models.ApplicationUser> UserManager
@{
    ViewData["Title"] = "Вход";
    var returnUrl = Model.ReturnUrl ?? Url.Content("~/");
}

<div class="ss-hero-mini mb-4">
    <div class="ss-hero-inner d-flex flex-wrap gap-3 align-items-end justify-content-between">
        <div>
            <h1 class="mb-1"><i class="bi bi-box-arrow-in-right"></i> Вход</h1>
            <div class="opacity-75">Влезте в профила си, за да продължите.</div>
        </div>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-md-7 col-lg-5">
        <div class="card ss-card">
            <div class="card-body">
                <form method="post" asp-route-returnUrl="@returnUrl" class="needs-validation" novalidate>
                    <h5 class="mb-3 fw-semibold">Вход в акаунта</h5>

                    @* Show helpful warning when POST failed and the account does not exist *@
                    @if (ViewContext.HttpContext.Request.Method == "POST")
                    {
                        var _exists = await UserManager.FindByEmailAsync(Model.Input?.Email ?? string.Empty);
                        if (_exists == null)
                        {
                            <div class="alert alert-warning">Акаунт с този имейл не съществува.</div>
                        }
                    }

                    <div class="mb-3">
                        <label asp-for="Input.Email" class="form-label">Електронна поща</label>
                        <input asp-for="Input.Email" type="email" class="form-control" />
                        <span asp-validation-for="Input.Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.Password" class="form-label">Парола</label>
                        <input asp-for="Input.Password" type="password" class="form-control" />
                        <span asp-validation-for="Input.Password" class="text-danger small"></span>
                    </div>

                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <div class="form-check">
                            <input asp-for="Input.RememberMe" class="form-check-input" />
                            <label asp-for="Input.RememberMe" class="form-check-label">Запомни ме</label>
                        </div>
                        <a asp-page="/Account/ForgotPassword" class="small">Забравена парола?</a>
                    </div>

                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-box-arrow-in-right me-1"></i> Влез
                    </button>

                    <div class="text-center mt-3 small text-muted">
                        Още нямате акаунт? <a asp-page="/Account/Register" class="text-decoration-none">Регистрирайте се</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
