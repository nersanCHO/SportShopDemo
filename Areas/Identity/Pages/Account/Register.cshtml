@page
@model SportShop.Areas.Identity.Pages.Account.RegisterModel
@{
    ViewData["Title"] = "Регистрация";
    var returnUrl = Model.ReturnUrl ?? Url.Content("~/");
}

<div class="ss-hero-mini mb-4">
    <div class="ss-hero-inner d-flex flex-wrap gap-3 align-items-end justify-content-between">
        <div>
            <h1 class="mb-1"><i class="bi bi-person-plus-fill"></i> Регистрация</h1>
            <div class="opacity-75">Създайте акаунт за пазаруване.</div>
        </div>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-md-7 col-lg-6 col-xl-5">
        <div class="card ss-card">
            <div class="card-body">
                <form method="post" asp-route-returnUrl="@returnUrl" class="needs-validation" novalidate>
                    <h5 class="mb-3 fw-semibold">Създаване на потребителски акаунт</h5>

                    <div class="mb-3">
                        <label asp-for="Input.Email" class="form-label">Електронна поща</label>
                        <input asp-for="Input.Email" type="email" class="form-control" />
                        <span asp-validation-for="Input.Email" class="text-danger small"></span>
                    </div>

                    <div class="row g-2">
                        <div class="col-6 mb-3">
                            <label asp-for="Input.Password" class="form-label">Парола</label>
                            <input asp-for="Input.Password" type="password" class="form-control" />
                            <span asp-validation-for="Input.Password" class="text-danger small"></span>
                        </div>
                        <div class="col-6 mb-3">
                            <label asp-for="Input.ConfirmPassword" class="form-label">Потвърдете паролата</label>
                            <input asp-for="Input.ConfirmPassword" type="password" class="form-control" />
                            <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-person-plus me-1"></i> Регистрирай се
                    </button>

                    <div class="text-center mt-3 small text-muted">
                        Вече имате акаунт? <a asp-page="/Account/Login" class="text-decoration-none">Влезте</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
